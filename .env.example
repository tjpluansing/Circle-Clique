# Copy this file to .env and fill in real values (Settings → API in the
# Supabase dashboard, under "Data API"). .env itself is gitignored and
# must never be committed — see CLAUDE.md section 3: "Config: .env and
# Supabase secrets, never committed. No API keys in code."
#
# The EXPO_PUBLIC_ prefix is required for Expo to inline these into the
# client bundle (https://docs.expo.dev/guides/environment-variables/).
# The anon/publishable key is safe to ship in the client — it only works
# through Row Level Security (see supabase/migrations/0002_phase1_rls.sql).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
